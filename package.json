{
  "name": "VisitorModule",
  "version": "1.0.0",
  "description": "A module made for course 1DV610 in Typescript, For tracking Visitors to a website",
  "type": "module",
  "main": "dist/app.js",
  "bin": {
    "ts-cli-template": "dist/app.js"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "tsx src/app.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:match": "vitest run -t",
    "lint": "eslint ./src --cache",
    "lint:fix": "eslint ./src --cache --fix",
    "format": "prettier --write ./src",
    "format:check": "prettier ./src --check"
  },
  "contributors": [
    "1dv610 Organization",
    "Felix Berglund <fb222rs@gmail.com>"
  ],
  "license": "MIT",
  "private": false,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lnu/eslint-config": "^2.0.13",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.3.10",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-regexp": "^3.3.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
